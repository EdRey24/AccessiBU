# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase Edge Functions local secrets (GEMINI_API_KEY etc.).
# Per the Supabase docs the runtime reads these values, so the file must never
# be committed. SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are injected by the
# platform and need not live here in production.
supabase/functions/.env
supabase/.temp/

# Kiro spec execution bookkeeping (session ids, timestamps) — local only.
.kiro/specs/*/tasks.meta.json
