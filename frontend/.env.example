# AccessiBU frontend environment variables.
# Copy this file to `.env` and fill in the values, then restart the dev server.
#   cp .env.example .env
#
# NOTE: `.env` is gitignored (it holds secrets), which is why a fresh clone
# has no map until you create it. This is the #1 reason the app "doesn't load"
# for a new teammate — the Mapbox token below is required for the map to render.

# Mapbox public access token (required for the 3D map + geocoding).
# Get a free token at https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=

# FastAPI base URL. Required. Sign-in and classification fail when this is blank.
# For local Docker, use:
#   http://localhost:8000
EXPO_PUBLIC_API_URL=
