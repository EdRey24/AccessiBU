# Local secrets template for Supabase Edge Functions.
#
# Copy to `supabase/functions/.env` (which is gitignored) for local runs, OR set
# these in production with `supabase secrets set --env-file <file>`.
#
# NOTE (verified against current Supabase docs):
#   * SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into Edge Functions
#     by the platform in production, so you typically only need them locally.
#   * GEMINI_API_KEY is a custom secret (its name must NOT start with SUPABASE_)
#     and is the key that must stay server-only — never bundle it into the Expo
#     client app.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
GEMINI_API_KEY=your-gemini-api-key
